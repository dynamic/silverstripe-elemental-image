{
    "name": "dynamic/silverstripe-elemental-image",
    "description": "A block to add a single image to your page.",
    "license": "BSD-3-Clause",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "elemental",
        "content",
        "blocks",
        "image"
    ],
    "authors": [
        {
            "name": "Dynamic",
            "email": "dev@dynamicagency.com",
            "homepage": "https://www.dynamicagency.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "dnadesign/silverstripe-elemental": "^6.0",
        "jonom/focuspoint": "^6.0",
        "silverstripe/recipe-cms": "^6.0",
        "silverstripe/linkfield": "^5.0",
        "silverstripe/vendor-plugin": "^2"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "silverstripe/recipe-testing": "^4",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Dynamic\\Elements\\Image\\": "src/",
            "Dynamic\\Elements\\Image\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        },
        "process-timeout": 600
    }
}
